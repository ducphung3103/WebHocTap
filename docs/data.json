  "curriculum": [
    {
      "module": "Chuyên đề 01: C++ Căn bản & Kỹ thuật Tối ưu I/O",
      "description": "Cấu trúc chương trình C++, các kiểu dữ liệu số nguyên lớn 64-bit, ép kiểu, Fast I/O và kiểm soát độ phức tạp thời gian O(N).",
      "doc_url": "https://docs.google.com/document/d/1sample_cpp_basics/edit?usp=sharing",
      "lecture_file": "lectures/01_cpp_can_ban.md",
      "lessons": [
        "1.1 Khởi tạo Template thi đấu C++ chuẩn & Kỹ thuật Fast I/O (cin.tie, sync_with_stdio)",
        "1.2 Xử lý số học: Overflow, __int128, lũy thừa nhanh chia để trị (Binary Exponentiation)",
        "1.3 Mảng 1 chiều, 2 chiều & Kỹ thuật Mảng cộng dồn (Prefix Sum), Mảng hiệu (Difference Array)"
      ]
    },
    {
      "module": "Chuyên đề 02: STL & Cấu trúc Dữ liệu Nền tảng",
      "description": "Làm chủ các container quan trọng của thư viện C++ STL trong giải thuật: vector, pair, set, map, priority_queue, deque.",
      "doc_url": "https://docs.google.com/document/d/1sample_stl_dsa/edit?usp=sharing",
      "lecture_file": "lectures/01_cpp_can_ban.md",
      "lessons": [
        "2.1 Vector, Sort đa tiêu chí với hàm Comparator, Binary Search & Chặt nhị phân kết quả",
        "2.2 Set, Multiset, Unordered_set: Tìm kiếm và duy trì tập hợp trong O(log N)",
        "2.3 Map, Unordered_map: Bảng băm đếm tần suất và nén tọa độ rời rạc",
        "2.4 Priority Queue (Hàng đợi ưu tiên) & Kỹ thuật Hai con trỏ (Two Pointers)"
      ]
    },
    {
      "module": "Chuyên đề 03: Quy hoạch Động Kinh điển (Dynamic Programming)",
      "description": "Tư duy tối ưu hóa bài toán con trùng lặp, xây dựng công thức truy hồi và bảng phương án.",
      "doc_url": "https://docs.google.com/document/d/1sample_dp/edit?usp=sharing",
      "lecture_file": "lectures/01_cpp_can_ban.md",
      "lessons": [
        "3.1 Quy hoạch động 1 chiều: Bài toán Bậc thang, Dãy con có tổng lớn nhất (Kadane)",
        "3.2 Dãy con tăng dài nhất (LIS O(N log N)) & Xâu con chung dài nhất (LCS)",
        "3.3 Bài toán Cái túi (Knapsack 0/1, Bounded & Unbounded Knapsack)",
        "3.4 Quy hoạch động trên ma trận lưới & Tối ưu hóa bộ nhớ DP"
      ]
    },
    {
      "module": "Chuyên đề 04: Thuật toán Đồ thị (Graph Algorithms)",
      "description": "Mô hình hóa bài toán đồ thị, biểu diễn danh sách kề và các thuật toán duyệt đồ thị cơ bản đến nâng cao.",
      "doc_url": "https://docs.google.com/document/d/1sample_graph/edit?usp=sharing",
      "lecture_file": "lectures/01_cpp_can_ban.md",
      "lessons": [
        "4.1 Biểu diễn đồ thị, Duyệt theo chiều sâu (DFS) & Duyệt theo chiều rộng (BFS)",
        "4.2 Cây khung nhỏ nhất (Kruskal & Thuật toán Disjoint Set Union - DSU)",
        "4.3 Đường đi ngắn nhất nguồn đơn: Thuật toán Dijkstra với priority_queue",
        "4.4 Đồ thị có hướng không chu trình (DAG) & Sắp xếp Tô pô (Topological Sort)"
      ]
    }
  ],

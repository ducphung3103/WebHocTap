# ==============================================================================
# Environment Configuration Template for Online Judge Tracker
# ==============================================================================

# Google Spreadsheet ID (found in URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
SPREADSHEET_ID=your_google_spreadsheet_id_here

# Path to Google Service Account JSON file (for local development)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# OR base64/raw JSON content (preferred for CI/CD GitHub Actions Secret: GCP_SA_KEY)
# GOAL: Leave empty if using GOOGLE_SERVICE_ACCOUNT_FILE locally
GOOGLE_SERVICE_ACCOUNT_JSON=

# Sheet Names in the Google Spreadsheet
STUDENTS_SHEET_NAME=Danh sách Học sinh
PROGRESS_SHEET_NAME=Theo dõi Bài tập

# Rate limiting and network retry configuration
REQUEST_DELAY_SECONDS=1.0
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Firebase Realtime Database Configuration (Bảo mật mã PIN học sinh)
# URL Database tạo tại https://console.firebase.google.com/
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DATABASE_SECRET=

